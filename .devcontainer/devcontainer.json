{
    "name": "website",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspaces/website",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/website,type=bind,consistency=cached",
    "containerEnv": {
        "QUARTO_PYTHON": "/usr/local/bin/python3"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "garytyler.darcula-pycharm",
                "openai.chatgpt",
                "GitHub.copilot-chat",
                "magicstack.MagicPython",
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-slideshow",
                "mechatroner.rainbow-csv",
                "James-Yu.latex-workshop",
                "quarto.quarto"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "python.defaultInterpreterPath": "/usr/local/bin/python3"
            }
        }
    }
}